---
layout: base.njk
title: AWS for Engineers
description: The best blog for software engineers to learn AWS. Beginner-friendly tutorials created by AWS experts.
pagination:
  data: collections.posts
  size: 15
  reverse: true
  alias: posts
permalink: "{% if pagination.pageNumber == 0 %}/blog/{% else %}/blog/page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<section class="blog-list wrap">
  <div class="section-heading">
    <p class="eyebrow">AWS for Engineers</p>
    <h1>Blog</h1>
    <p>Practical AWS guides and tutorials for software engineers.</p>
  </div>
  <div class="post-grid">
    {% for post in posts %}
    <a class="post-card" href="{{ post.url }}">
      {% if post.data.heroImage %}<img src="{{ post.data.heroImage }}" alt="" eleventy:widths="320,480,768,1200,1536" sizes="{% if loop.first %}(max-width: 600px) calc(100vw - 32px), (max-width: 800px) calc(100vw - 48px), (max-width: 1218px) calc((200vw - 116px) / 3), 774px{% else %}(max-width: 600px) calc(100vw - 32px), (max-width: 800px) calc((100vw - 68px) / 2), (max-width: 1218px) calc((100vw - 88px) / 3), 377px{% endif %}" loading="{{ 'eager' if loop.first else 'lazy' }}"{% if loop.first %} fetchpriority="high"{% endif %}>{% endif %}
      <h2>{{ post.data.title }}</h2>
    </a>
    {% endfor %}
  </div>
  <nav class="pagination" aria-label="Blog pages">
    {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← Newer posts</a>{% endif %}
    <span>Page {{ pagination.pageNumber + 1 }} of {{ pagination.pages.length }}</span>
    {% if pagination.href.next %}<a href="{{ pagination.href.next }}">Older posts →</a>{% endif %}
  </nav>
</section>
