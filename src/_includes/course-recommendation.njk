<article class="course-card">
  <h3>{{ selectedCourse.name }}</h3>
  {% if selectedCourse.instructor %}<p class="course-instructor">Instructor: {{ selectedCourse.instructor }}</p>{% endif %}
  <p>{{ selectedCourse.reason }}</p>
  {% if selectedCourse.qualification %}<p class="course-qualification">{{ selectedCourse.qualification }}</p>{% endif %}
  <p class="course-disclosure">Affiliate disclosure: I may earn a commission if you buy through these links.</p>
  <p class="course-link"><a href="{{ selectedCourse.affiliateUrl }}" rel="sponsored">View {{ selectedCourse.name }} on learn.cantrill.io →</a></p>
</article>
